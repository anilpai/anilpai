---
import Layout from '../layouts/Layout.astro';

const title = "Anil Pai — Co-Founder & CTO at Loopdesk AI";
const description = "Anil Pai — Co-Founder & CTO at Loopdesk AI. Engineer with 15+ years building scalable systems at Microsoft, Expedia, and Autodesk. Building AI-powered video editing.";
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section id="hero" class="hero">
    <div class="container">
      <div class="hero-content fade-in-up">
        <h1 class="hero-title">Building the future of AI-powered video editing.</h1>
        <p class="hero-subtitle">
          I'm <strong>Anil Pai</strong> — engineer, co-founder, and builder. Currently building <strong>Loopdesk AI</strong> — an agentic AI platform that edits video through conversation.
        </p>
        <div class="hero-cta">
          <a href="https://github.com/anilpai" target="_blank" rel="noopener noreferrer" class="btn">
            View My Work
          </a>
          <a href="https://www.linkedin.com/in/anilpai/" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            Connect on LinkedIn
          </a>
        </div>
        <p class="hero-caption">
          Bengaluru, India · MS, Syracuse University · Ex-Microsoft, Expedia, Autodesk
        </p>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about">
    <div class="container">
      <div class="about-grid">
        <div class="about-content fade-in-up">
          <h2 class="section-title">About</h2>
          <div class="about-text">
            <p>I build products at the intersection of AI, video, and developer infrastructure.</p>
            
            <p>Over 15+ years, I've shipped scalable systems at <strong>Microsoft</strong>, <strong>Expedia/Vrbo</strong>, and <strong>Autodesk</strong> — working on everything from enterprise platforms to design tooling.</p>
            
            <p>Today, I'm the <strong>Co-Founder & CTO of Loopdesk AI</strong>, where we're building agentic AI systems that transform how video is edited — through chat, not timelines.</p>
            
            <p>I also write about computer science and algorithms on Medium, where I created the Mind-boggling Algorithms publication.</p>
          </div>
        </div>
        <div class="about-skills fade-in-up">
          <h3>Core Expertise</h3>
          <ul class="skills-list">
            <li>AI systems & agentic workflows</li>
            <li>Full-stack product architecture (JavaScript, TypeScript, Python)</li>
            <li>Video processing pipelines (FFmpeg, WebCodecs)</li>
            <li>Developer infrastructure & scalable backends</li>
            <li>Algorithmic problem-solving & CS fundamentals</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Current Focus - Loopdesk AI -->
  <section id="loopdesk" class="loopdesk">
    <div class="container">
      <div class="loopdesk-header fade-in-up">
        <h2 class="section-title">Current Focus — Loopdesk AI</h2>
        <p class="loopdesk-tagline">You Create. We Edit. It's That Simple.</p>
      </div>
      
      <div class="features-grid">
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">🤖</div>
          <h3>Agentic Editing</h3>
          <p>Chat with AI agents to make edits</p>
        </div>
        
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">🎥</div>
          <h3>AI Visual Understanding</h3>
          <p>Automatic scene analysis, speaker detection</p>
        </div>
        
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">🎬</div>
          <h3>Generative B-Roll</h3>
          <p>AI-generated footage matching script and style</p>
        </div>
        
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">✂️</div>
          <h3>Smart Trimming & Captioning</h3>
          <p>Auto-detect key moments, trim dead air</p>
        </div>
        
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">📱</div>
          <h3>One-Click Distribution</h3>
          <p>Publish to YouTube, TikTok, Instagram, X, Twitch</p>
        </div>
        
        <div class="feature-card card fade-in-up">
          <div class="feature-icon">🎙️</div>
          <h3>Specialized Workflows</h3>
          <p>Podcasts, vlogs, shorts/reels, keynotes</p>
        </div>
      </div>
      
      <div class="loopdesk-traction fade-in-up">
        <p class="traction-text">
          1,000+ beta creators · 50,000+ videos edited · 4.9/5 avg rating · Bootstrapped
        </p>
        <a href="https://www.loopdesk.ai" target="_blank" rel="noopener noreferrer" class="btn">
          Try Loopdesk
        </a>
      </div>
    </div>
  </section>

  <!-- Experience Timeline -->
  <section id="experience" class="experience">
    <div class="container">
      <h2 class="section-title fade-in-up">Experience</h2>
      <div class="timeline">
        <div class="timeline-item fade-in-up">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Co-Founder & CTO — Loopdesk AI</h3>
            <p class="timeline-period">2025 – Present</p>
            <p class="timeline-description">
              Building AI-native video editing infrastructure. Agentic chat-based workflows. GPU-accelerated processing.
            </p>
          </div>
        </div>
        
        <div class="timeline-item fade-in-up">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Microsoft</h3>
            <p class="timeline-description">
              Enterprise-scale systems engineering and product development.
            </p>
          </div>
        </div>
        
        <div class="timeline-item fade-in-up">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Expedia / Vrbo</h3>
            <p class="timeline-description">
              Performance-driven travel technology platforms and large-scale systems.
            </p>
          </div>
        </div>
        
        <div class="timeline-item fade-in-up">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Autodesk</h3>
            <p class="timeline-description">
              Developer-facing tools and design platform engineering.
            </p>
          </div>
        </div>
        
        <div class="timeline-item fade-in-up">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Education</h3>
            <p class="timeline-description">
              MS in Computer Engineering — Syracuse University
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Thinking / Philosophy -->
  <section id="thinking" class="thinking">
    <div class="container">
      <div class="thinking-content fade-in-up">
        <h2 class="section-title">Thinking</h2>
        <blockquote class="philosophy-quote">
          "AI isn't a feature. It's an infrastructure layer."
        </blockquote>
        <div class="thinking-topics">
          <h3>Areas of Focus</h3>
          <ul class="topics-list">
            <li>Agentic AI systems & tool orchestration</li>
            <li>Video understanding through multimodal models</li>
            <li>Workflow compression</li>
            <li>Human + AI collaboration in creative work</li>
            <li>Algorithmic thinking</li>
            <li>Building durable bootstrapped tech companies</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Writing & Open Source -->
  <section id="writing" class="writing">
    <div class="container">
      <h2 class="section-title fade-in-up">Writing & Open Source</h2>
      <div class="writing-grid">
        <div class="writing-card card fade-in-up">
          <h3>📝 Writing</h3>
          <p>I write about algorithms and computer science on Medium, where I created the <strong>Mind-boggling Algorithms</strong> publication.</p>
          <div class="writing-links">
            <a href="https://anilpai.medium.com/" target="_blank" rel="noopener noreferrer" class="link">Medium Blog →</a>
            <a href="https://medium.com/mind-boggling-algorithms" target="_blank" rel="noopener noreferrer" class="link">Mind-boggling Algorithms →</a>
          </div>
        </div>
        
        <div class="writing-card card fade-in-up">
          <h3>💻 Open Source</h3>
          <p>Contributing to the developer community through open-source projects and sharing knowledge.</p>
          <div class="writing-links">
            <a href="https://github.com/anilpai" target="_blank" rel="noopener noreferrer" class="link">GitHub Profile →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Tech Stack -->
  <section id="tech-stack" class="tech-stack">
    <div class="container">
      <h2 class="section-title fade-in-up">Tech Stack</h2>
      <div class="tech-grid fade-in-up">
        <span class="tech-tag">JavaScript</span>
        <span class="tech-tag">TypeScript</span>
        <span class="tech-tag">React</span>
        <span class="tech-tag">Next.js</span>
        <span class="tech-tag">Python</span>
        <span class="tech-tag">AI/LLM APIs</span>
        <span class="tech-tag">Multimodal AI</span>
        <span class="tech-tag">FFmpeg</span>
        <span class="tech-tag">WebCodecs</span>
        <span class="tech-tag">Cloud Infrastructure</span>
        <span class="tech-tag">Distributed Systems</span>
        <span class="tech-tag">Node.js</span>
      </div>
    </div>
  </section>

  <!-- Contact / Footer -->
  <section id="contact" class="contact">
    <div class="container">
      <div class="contact-content fade-in-up">
        <h2 class="contact-title">Let's Build Something Together</h2>
        <div class="contact-links">
          <a href="https://x.com/anilbpai" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">𝕏</span>
            <span>X/Twitter</span>
          </a>
          <a href="https://www.linkedin.com/in/anilpai/" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">💼</span>
            <span>LinkedIn</span>
          </a>
          <a href="https://github.com/anilpai" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">💻</span>
            <span>GitHub</span>
          </a>
          <a href="https://anilpai.medium.com/" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">📝</span>
            <span>Medium</span>
          </a>
          <a href="https://www.loopdesk.ai" target="_blank" rel="noopener noreferrer" class="contact-link">
            <span class="icon">🚀</span>
            <span>Loopdesk AI</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 4rem 0;
  }

  .hero-content {
    max-width: 900px;
  }

  .hero-title {
    font-size: clamp(2.5rem, 8vw, 6rem);
    font-weight: 900;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .hero-caption {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* About Section */
  .about {
    background: var(--bg-secondary);
    color: var(--text-secondary);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 968px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 2rem;
  }

  .about-text p {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  .about-skills h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .skills-list {
    list-style: none;
  }

  .skills-list li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    font-size: 1.125rem;
  }

  .skills-list li:last-child {
    border-bottom: none;
  }

  .skills-list li::before {
    content: "→ ";
    color: var(--accent);
    font-weight: bold;
    margin-right: 0.5rem;
  }

  /* Loopdesk Section */
  .loopdesk {
    background: var(--bg-primary);
  }

  .loopdesk-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .loopdesk-tagline {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    margin-top: 1rem;
    color: var(--accent);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .feature-card {
    text-align: center;
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--text-muted);
  }

  .loopdesk-traction {
    text-align: center;
    padding: 3rem;
    background: var(--card-bg);
    border-radius: 1rem;
    border: 1px solid var(--border);
  }

  .traction-text {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    color: var(--text-muted);
  }

  /* Experience Timeline */
  .experience {
    background: var(--bg-secondary);
    color: var(--text-secondary);
  }

  .timeline {
    position: relative;
    padding-left: 3rem;
    margin-top: 3rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-marker {
    position: absolute;
    left: -3.375rem;
    top: 0.5rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--accent);
    border-radius: 50%;
    border: 3px solid var(--bg-secondary);
  }

  .timeline-content h3 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .timeline-period {
    color: var(--accent);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .timeline-description {
    color: #666;
    font-size: 1.125rem;
    line-height: 1.6;
  }

  /* Thinking Section */
  .thinking {
    background: var(--bg-primary);
  }

  .thinking-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .philosophy-quote {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 600;
    font-style: italic;
    margin: 3rem 0;
    padding: 2rem;
    border-left: 4px solid var(--accent);
    text-align: left;
  }

  .thinking-topics {
    margin-top: 3rem;
    text-align: left;
  }

  .thinking-topics h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .topics-list {
    list-style: none;
  }

  .topics-list li {
    padding: 0.75rem 0;
    font-size: 1.125rem;
    border-bottom: 1px solid var(--border);
  }

  .topics-list li:last-child {
    border-bottom: none;
  }

  .topics-list li::before {
    content: "• ";
    color: var(--accent);
    font-weight: bold;
    margin-right: 0.5rem;
  }

  /* Writing Section */
  .writing {
    background: var(--bg-secondary);
    color: var(--text-secondary);
  }

  .writing-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  .writing-card {
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .writing-card h3 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .writing-card p {
    color: #666;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .writing-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .link {
    color: var(--accent);
    font-weight: 600;
    transition: transform 0.2s ease;
    display: inline-block;
  }

  .link:hover {
    transform: translateX(5px);
  }

  /* Tech Stack Section */
  .tech-stack {
    background: var(--bg-primary);
  }

  .tech-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3rem;
    justify-content: center;
  }

  .tech-tag {
    padding: 0.75rem 1.5rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 50px;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: default;
  }

  .tech-tag:hover {
    border-color: var(--accent);
    background: rgba(59, 130, 246, 0.1);
    transform: translateY(-2px);
  }

  /* Contact Section */
  .contact {
    background: var(--bg-secondary);
    color: var(--text-secondary);
    padding: 6rem 0;
  }

  .contact-content {
    text-align: center;
  }

  .contact-title {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 3rem;
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .contact-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    background: white;
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 1rem;
    transition: all 0.3s ease;
    min-width: 120px;
  }

  .contact-link:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2);
    transform: translateY(-2px);
  }

  .contact-link .icon {
    font-size: 2rem;
  }

  .contact-link span:last-child {
    font-weight: 600;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .contact-links {
      gap: 1rem;
    }
    
    .contact-link {
      min-width: 100px;
      padding: 1rem;
    }
  }
</style>
